{
  "_comment": [
    "Where every tool comes from and how to recognise it.",
    "",
    "NOTHING HERE IS VENDORED. This file describes tools that live at",
    "the directory named by the EMBD_TOOLCHAINS environment variable",
    "(default: the 'root' field below). It never contains a compiler.",
    "'detect' is how we know a tool is really present and which version --",
    "probing rather than trusting a path is what stops a half-finished",
    "install from looking like a working one.",
    "",
    "'install' is deliberately a URL plus a human instruction, not an",
    "automated silent installer. Several of these vendors require accepting a",
    "licence or registering, and scripting around that would be both fragile",
    "and wrong.",
    "Globs are version-agnostic on purpose: every one of these was first written as a fixed path and every one of them was wrong. A toolchain upgrade must not silently turn into 'missing'."
  ],
  "root": "~/.local/share/niusburner/toolchains",
  "compilers": {
    "sdcc": {
      "family": [
        "mcs51",
        "stm8",
        "pic14",
        "pic16"
      ],
      "detect": {
        "any": [
          {
            "cmd": "sdcc",
            "args": [
              "--version"
            ],
            "match": "SDCC"
          },
          {
            "path": "C:\\Program Files\\SDCC\\bin\\sdcc.exe"
          },
          {
            "path": "C:\\Program Files (x86)\\SDCC\\bin\\sdcc.exe"
          }
        ]
      },
      "install": {
        "url": "https://sourceforge.net/projects/sdcc/files/",
        "note": "Installer adds itself to PATH. Free, GPL."
      },
      "note": "Primary 8051 compiler. No C++ mode at all, which is why an 8051 Arduino core needs IAR instead."
    },
    "iar_8051": {
      "family": [
        "mcs51"
      ],
      "detect": {
        "cmd": "icc8051",
        "args": [
          "--version"
        ],
        "match": "IAR"
      },
      "install": {
        "url": "https://www.iar.com/ew8051",
        "note": "Commercial, size-limited evaluation available. Requires registration; cannot be scripted."
      },
      "note": "The only 8051 compiler here with C++ (--eec++), so the only one an Arduino core can be built on."
    },
    "xc8": {
      "family": [
        "pic10",
        "pic12",
        "pic16",
        "pic18"
      ],
      "detect": {
        "any": [
          {
            "glob": "${EMBD_TOOLCHAINS}/pic/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "C:\\embd_toolchains/pic/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "C:\\Program Files\\Microchip/pic/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "C:\\Program Files (x86)\\Microchip/pic/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "/opt/microchip/pic/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "C:\\embd_toolchains/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "C:\\Program Files\\Microchip/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "C:\\Program Files (x86)\\Microchip/xc8/*/bin/xc8-cc.exe"
          },
          {
            "glob": "/opt/microchip/xc8/*/bin/xc8-cc.exe"
          },
          {
            "cmd": "xc8-cc",
            "args": [
              "--version"
            ],
            "match": ""
          }
        ]
      },
      "install": {
        "url": "https://www.microchip.com/mplab/compilers",
        "note": "Free tier works; unoptimised but complete. Silent install supported."
      }
    },
    "xc16": {
      "family": [
        "pic24",
        "dspic33"
      ],
      "detect": {
        "any": [
          {
            "glob": "${EMBD_TOOLCHAINS}/pic/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "C:\\embd_toolchains/pic/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "C:\\Program Files\\Microchip/pic/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "C:\\Program Files (x86)\\Microchip/pic/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "/opt/microchip/pic/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "C:\\embd_toolchains/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "C:\\Program Files\\Microchip/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "C:\\Program Files (x86)\\Microchip/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "glob": "/opt/microchip/xc16/*/bin/xc16-gcc.exe"
          },
          {
            "cmd": "xc16-gcc",
            "args": [
              "--version"
            ],
            "match": ""
          }
        ]
      },
      "install": {
        "url": "https://www.microchip.com/mplab/compilers"
      }
    },
    "xc32": {
      "family": [
        "pic32"
      ],
      "detect": {
        "any": [
          {
            "glob": "${EMBD_TOOLCHAINS}/pic/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "C:\\embd_toolchains/pic/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "C:\\Program Files\\Microchip/pic/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "C:\\Program Files (x86)\\Microchip/pic/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "/opt/microchip/pic/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "C:\\embd_toolchains/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "C:\\Program Files\\Microchip/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "C:\\Program Files (x86)\\Microchip/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "glob": "/opt/microchip/xc32/*/bin/xc32-gcc.exe"
          },
          {
            "cmd": "xc32-gcc",
            "args": [
              "--version"
            ],
            "match": ""
          }
        ]
      },
      "install": {
        "url": "https://www.microchip.com/mplab/compilers"
      }
    },
    "msp430_gcc": {
      "family": [
        "msp430"
      ],
      "detect": {
        "glob": "${EMBD_TOOLCHAINS}/msp430/msp430-gcc-*/bin/msp430-elf-gcc.exe"
      },
      "install": {
        "url": "https://www.ti.com/tool/MSP430-GCC-OPENSOURCE",
        "note": "Unpack below the configured toolchain root. Free."
      }
    },
    "c2000": {
      "family": [
        "c2000"
      ],
      "detect": {
        "glob": "${EMBD_TOOLCHAINS}/c2000/*/ti-cgt-c2000*/bin/cl2000.exe"
      },
      "install": {
        "url": "https://www.ti.com/tool/C2000-CGT",
        "note": "Free. C++14 capable, which is why a C2000 Arduino core is possible."
      }
    },
    "arm_none_eabi": {
      "family": [
        "cortex-m"
      ],
      "detect": {
        "cmd": "arm-none-eabi-gcc",
        "args": [
          "--version"
        ],
        "match": "arm-none-eabi"
      },
      "install": {
        "url": "https://developer.arm.com/downloads/-/arm-gnu-toolchain-downloads",
        "note": "Portable: unpack below the configured toolchain root and add bin to PATH for the session."
      },
      "note": "Available for standalone firmware, CI, release packaging, and independent verification that require a caller-pinned compiler revision."
    },
    "riscv_none_elf": {
      "family": [
        "rv32",
        "rv64"
      ],
      "detect": {
        "glob": "${EMBD_TOOLCHAINS}/riscv/xpack-riscv-none-elf-gcc-*/bin/riscv-none-elf-gcc.exe"
      },
      "install": {
        "url": "https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases",
        "note": "Portable xPack build. Unpack below the configured toolchain root."
      }
    }
  },
  "programmers": {
    "usbasp": {
      "programs": [
        "at89s51",
        "at89s52",
        "avr"
      ],
      "transport": "usb",
      "detect": {
        "cmd": "avrdude",
        "args": [
          "-v"
        ],
        "match": "avrdude"
      },
      "note": "Genuine USBasp (VID 16C0 / PID 05DC) driven by avrdude. Not the USB-ISP HID programmer (03EB / C8B4).",
      "wiring": "docs/wiring/usbasp-idc10.md"
    },
    "usbisp_hid": {
      "programs": [
        "at89s51",
        "at89s52"
      ],
      "transport": "usb",
      "detect": {
        "vid": "0x03EB",
        "pid": "0xC8B4"
      },
      "note": "USB-ISP HID programmer (VID 03EB / PID C8B4) over HidUsb. AT89S51/S52 serial-ISP. Headless: python -m niusburner probe|flash. Do not install WinUSB.",
      "wiring": "docs/wiring/usbasp-idc10.md"
    },
    "nano_at89c2051": {
      "programs": [
        "at89c2051",
        "at89c4051"
      ],
      "transport": "serial",
      "firmware": "hardware/nano_at89c2051/",
      "note": "The AT89C2051 has NO ISP at all. It needs a 12 V parallel programming sequence, so we build the programmer ourselves on a Nano.",
      "wiring": "hardware/nano_at89c2051/README.md"
    },
    "stcgal": {
      "programs": [
        "stc15w408as",
        "stc8",
        "stc89",
        "stc89c52rc"
      ],
      "transport": "serial",
      "detect": {
        "cmd": "stcgal",
        "args": [
          "--version"
        ],
        "match": ""
      },
      "install": {
        "url": "https://github.com/grigorig/stcgal",
        "note": "pip install stcgal"
      },
      "note": "Serial bootloader, entered by power-cycling the target while the tool waits. STC89 and STC15 parts are not programmed through the AT89S SPI ISP header."
    },
    "pickit3": {
      "programs": [
        "pic12f675",
        "pic16f877a"
      ],
      "transport": "usb",
      "note": "Dropped by MPLAB X 6.x. Use MPLAB IPE 5.50 or earlier, or a PICkit 4/5.",
      "wiring": "docs/families/pic.md",
      "detect": {
        "any": [
          {
            "glob": "H:\\MPLABX\\*\\mplab_platform\\mplab_ipe\\ipecmd.exe"
          },
          {
            "glob": "C:\\Program Files\\Microchip\\MPLABX\\*\\mplab_platform\\mplab_ipe\\ipecmd.exe"
          },
          {
            "glob": "C:\\Program Files (x86)\\Microchip\\MPLABX\\*\\mplab_platform\\mplab_ipe\\ipecmd.exe"
          },
          {
            "glob": "/opt/microchip/mplabx/*/mplab_platform/mplab_ipe/ipecmd"
          }
        ]
      }
    }
  }
}
