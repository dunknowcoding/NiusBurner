# Internal working directory: plans, progress, scratch, build cache.
# Everything in here is private and pruned regularly.
_work/
_backups/

# Toolchains are NEVER vendored. They live below a caller-selected root.
# If one is ever unpacked here by accident, it must not be committed.
toolchains/
vendor/
# One exception, and it is not a toolchain: niusburner/vendor/ carries
# small pure-Python libraries that an upload needs at run time, with their
# licences and a record of what was changed. The rule above exists to keep
# compilers and their multi-megabyte trees out of the history, which is a
# different thing from a library the package imports.
!niusburner/vendor/
*.tar.gz
*.tar.xz
*.zip
*.7z
*.exe
*.msi

.niusburner/
*.ihx
*.hex
*.bin
*.elf
*.rel
*.rst
*.sym
*.lst
*.asm
*.map
*.mem
*.lk
*.cdb
*.adb
*.omf
*.o
*.obj
*.d
*.p1
*.sdb

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# Editors and OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# MPLAB drops this wherever it is run from.
MPLABXLog.xml

# Host tests. They exercise internals and pin down decisions that only
# matter to whoever is changing this code; a user installing NiusBurner
# has no use for them. Kept locally, not published.
tests/
